# Environment variables for the optional AI assistant (Sarvam AI). DECISIONS D41.
# The app reads the process environment only; it never loads a .env file, and .env is git-ignored.
# Never put a real key in this file, in the code, in logs, in issues or in screenshots. Set it in your shell instead:
#   read -rs SARVAM_API_KEY && export SARVAM_API_KEY
SARVAM_API_KEY=
# Optional overrides (defaults shown in app/assistant/config.py):
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_REASONING_EFFORT=low
